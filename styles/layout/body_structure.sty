
\newcommand{\sectionColor}{heading}
\newcommand{\subsectionColor}{emphasis}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% SECTIONS, SUBSECTIONS, AND MORE
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% redefine section in caps, bold and with rule below
\renewcommand{\section}[2][]{%
%    \bigskip%
    % \ifstrequal{#1}{}{}{\marginpar{\vspace*{\dimexpr 1pt-\baselineskip}\raggedright\input{#1}}}%
    \ifstrequal{#1}{}{}{\large \makebox[5mm][c]{#1}\hspace{0.5em}}
    {\color{\sectionColor}\Large\bfseries\MakeUppercase{#2}}\\[-1ex]%
    {\color{\sectionColor}\rule{\linewidth}{1.0pt}\par}\smallskip
}

% redefine subsection as bold
\renewcommand{\subsection}[1]{%
  \smallskip%
  {\color{\subsectionColor}\large\bfseries{#1}\par}\medskip
}
