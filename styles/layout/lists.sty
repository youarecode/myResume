\newcommand{\itemBulletColor}{red}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%% ItemList
\newenvironment{itemList}{ %
    \renewcommand{\descriptionlabel}[1]{%
        \def\temp{##1}%
        \ifx\temp\empty % Default bullet
            \textbf{\color{\itemBulletColor}\tiny\faSquare}%
        \else %
            \textbf{\color{\itemBulletColor}##1}
        \fi%
        }%
\begin{description}}
{\end{description}}

