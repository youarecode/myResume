%---------------------------------------------------------
%	THEMES (Colors palletes)
%---------------------------------------------------------

\newcommand{\topTheme}[5]{
    \def\topBackgroundColor{#1}
    \def\topTextColor{#2}
    \def\topTextSecColor{#3}
    \def\topHighlightColor{#4}
    \def\topEmphColor{#5}
}

\newcommand{\bodyTheme}[4]{
    \def\bodyBackgroundColor{#1}
    \def\bodyTextColor{#2}
    \def\bodyHighlightColor{#3}
    \def\bodyEmphColor{#4}
    \color{\bodyTextColor} % Default text color
}

\newcommand{\sidebarTheme}[6]{
    \newcommand\sideBarBackgroundColor{#1}
    \newcommand\sideBarTextColor{#2}
    \newcommand\sideBarHighlightColor{#3}
    \newcommand\sideBarEmphColor{#4}

    \newcommand{\degreeEmphColor}{#5}
    \newcommand{\jobEmphColor}{#5}
    \newcommand{\degreeDateColor}{#6}
    \newcommand{\jobDateColor}{#6}
}

