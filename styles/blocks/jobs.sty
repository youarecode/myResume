% format job/school list
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% set length of date/place column versus position column in fraction of linewidth before linewidth gets redefined in minipages
\newlength{\jobdateplacelength}
\newlength{\jobpositionlength}
\setlength{\jobdateplacelength}{0.4\linewidth}
\setlength{\jobpositionlength}{0.6\linewidth}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Job
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\job}[4]{%date start - end, 
                     %Job position, 
                     %sector, company
\begin{minipage}[c]{3mm}%
    \color{\jobFrameColor}\scriptsize\faGraduationCap
\end{minipage}%
\hspace{0.5em}%
\begin{minipage}[t]{\dimexpr \textwidth-0.5em-3mm}%
    \begin{flushleft}
        \large{%
            \textbf{%
            \color{\jobEmphColor}%
            #2%
            \hfill%
            }}\\
        \small{%
            \color{\jobTextColor}%
            #3%
            \hfill}\\
        \vspace{-3.4ex}%
        \normalsize{%
            \color{\jobFrameColor}%
            \hrulefill%
            \hspace{1mm}%
            \raisebox{-0.5ex}{#1}%
            }\\
        \small{%
            #4 }
    \end{flushleft}
\end{minipage}%
\vspace{1em}
}




