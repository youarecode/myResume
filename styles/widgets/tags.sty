\newcommand{\tagForeColor}{Black}
\newcommand{\tagBackColor}{GreenIT}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% squared tag
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\tagValueOneColor}{\tagBackColor!15!White}
\newcommand{\tagValueTwoColor}{\tagBackColor!30!White}
\newcommand{\tagValueThreeColor}{\tagBackColor!45!White}
\newcommand{\tagValueFourColor}{\tagBackColor!60!White}
\newcommand{\tagValueFiveColor}{\tagBackColor!75!White}
\newcommand{\tagValueDefaultColor}{White}

\newcounter{tagColorValue}%
\newcounter{tagColorLineWidth}%
\newcommand{\tag}[2][0]{% tag, depthValue
    \setcounter{tagColorValue}{#1}%
    % \setcounter{tagColorLineWidth}{{\numexpr \thetagColorValue - 0.5}}%
    \ifthenelse{\thetagColorValue=1}{%
        \def\tagColor{\tagValueOneColor}%
        % \setcounter{tagColorLineWidth}{}%
        }{%
    \ifthenelse{\thetagColorValue=2}{%
        \def\tagColor{\tagValueTwoColor}%
        }{%
    \ifthenelse{\thetagColorValue=3}{%
        \def\tagColor{\tagValueThreeColor}%
        }{%
    \ifthenelse{\thetagColorValue=4}{%
        \def\tagColor{\tagValueFourColor}%
        }{%
    \ifthenelse{\thetagColorValue=5}{%
        \def\tagColor{\tagValueFiveColor}%
        }{%
        \def\tagColor{\tagValueDefaultColor}%
        }}}}}%
    % \tagColor
    \tikz[baseline]\node[anchor=base,draw=\tagForeColor,rounded corners,inner xsep=0.75ex,inner ysep =0.75ex,text height=1.5ex,text depth=0.25ex, line width=0.1 mm, fill=\tagColor]{#2};
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% category box: groups several \tag's under one bordered box, with the
% category name centered on its own line inside -- if the label is wider
% than the tags themselves, the box simply widens to fit it whole rather
% than truncating.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newsavebox{\tagGroupTagsBox}
\newsavebox{\tagGroupTitleBox}
\newlength{\tagGroupWidth}
\newlength{\tagGroupMaxWidth}
% category title: small tracked caps (Montserrat Bold has no true small caps)
\newcommand{\tagGroupTitleText}[1]{{\bfseries\fontsize{6.2}{7}\selectfont\addfontfeature{LetterSpace=10}\MakeUppercase{#1}}}
\newcommand{\tagGroup}[3]{% #1=category color, #2=label, #3=content (usually a run of \tag calls)
    \renewcommand{\tagBackColor}{#1}%
    \setlength{\tagGroupMaxWidth}{0.92\linewidth}%
    \sbox{\tagGroupTagsBox}{#3}%
    \sbox{\tagGroupTitleBox}{\tagGroupTitleText{#2}}%
    \setlength{\tagGroupWidth}{\wd\tagGroupTagsBox}%
    \ifdim\tagGroupWidth>\tagGroupMaxWidth
        % too many tags for one line: rewrap them inside a fixed-width
        % box so they flow onto a second (or third) row instead of
        % running off the page.
        \setlength{\tagGroupWidth}{\tagGroupMaxWidth}%
        \sbox{\tagGroupTagsBox}{\begin{minipage}[t]{\tagGroupWidth}\centering#3\end{minipage}}%
    \fi
    % the title band is the label plus \fboxsep padding on each side
    \ifdim\dimexpr\wd\tagGroupTitleBox+2\fboxsep\relax>\tagGroupWidth
        \setlength{\tagGroupWidth}{\dimexpr\wd\tagGroupTitleBox+2\fboxsep\relax}%
    \fi
    \tcbox[on line,colframe=#1!65!black,colback=white,boxrule=0.5pt,arc=2mm,boxsep=0pt,left=0.8mm,right=0.8mm,top=0.8mm,bottom=1.3mm]{%
        \begin{tabular}{@{}p{\tagGroupWidth}@{}}
        \colorbox{#1!35!white}{\rule[-1.6pt]{0pt}{5.9pt}\makebox[\dimexpr\tagGroupWidth-2\fboxsep\relax][c]{\tagGroupTitleText{#2}}}\\[0.5em]
        \centering\usebox{\tagGroupTagsBox}
        \end{tabular}
    }%
}

% \taglegenditem{color}{label} -- small inline swatch explaining a tag category color
\newcommand{\taglegenditem}[2]{%
    \tikz[baseline=-0.3ex]\node[rounded corners=0.5pt,draw=#1!65!black,line width=0.4pt,fill=#1!30!white,minimum width=3.2mm,minimum height=2.6mm,inner sep=0pt]{};\,#2%
}

