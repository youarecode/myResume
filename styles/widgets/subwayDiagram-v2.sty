%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% subway-style career timeline (horizontal, wrapping layout)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% \subwayItemH[color]{title}{subtitle}
\newcommand{\subwayItemH}[3][GreenIT]{%
    \tikz[baseline=(box.base)]{%
        \node[
            rounded corners=0.6mm,
            draw=#1!70!black,
            line width=0.5pt,
            fill=#1,
            fill opacity=0.55,
            text opacity=1,
            minimum width=5mm,
            minimum height=5mm,
            inner sep=2pt,
            text width=2.3cm,
            font=\fontsize{7}{8}\selectfont,
            align=center,
            name=box
        ] {%
            {\bfseries #2}\\[-0.2ex]%
            {\fontsize{6}{7}\selectfont\itshape #3}%
        };%
    }%
}

