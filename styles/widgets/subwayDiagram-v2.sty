% \subwayLegendItemH{color}{label}
\newcommand{\subwayLegendItemH}[2]{%
    \tikz[baseline=-0.5ex]\node[
        rounded corners=0.4mm,
        draw=#1!70!black,
        line width=0.4pt,
        fill=#1,
        fill opacity=0.55,
        minimum width=3.2mm,
        minimum height=3.2mm,
        inner sep=0pt
    ]{};\,#2%
}

